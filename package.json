{
  "name": "bento-mail",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "next start",
    "preview": "next start",
    "dev": "next dev",
    "dev:services": "npm run build:services -- --watch --no-minify",
    "build:dev": "next build",
    "build": "next build",
    "build:services": "tsup src/services --clean --format esm --out-dir dist/services --tsconfig tsconfig.services.json",
    "lint": "next lint",
    "unzip": "[ ! -d samples ] && unzip -q samples.zip || true",
    "postinstall": "npm run unzip",
    "test": "vitest",
    "mail": "npx nodemon --watch ./dist/services --exec node scripts/start-mail-server.mjs",
    "worker": "npx nodemon --watch ./dist/services --exec node scripts/start-worker.mjs",
    "agendash": "source .env && npx agendash --db=\"$MONGODB_URI\""
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.30",
    "@langchain/core": "^0.3.21",
    "@langchain/openai": "^0.3.12",
    "@typegoose/typegoose": "^12.19.0",
    "agenda": "^5.0.0",
    "axios": "^1.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.544.0",
    "maildev": "^2.2.1",
    "mongoose": "^8.18.1",
    "next": "^15.5.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/maildev": "^0.0.7",
    "@types/node": "^22.18.1",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.21",
    "@types/turndown": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "llm-scraper": "^1.6.0",
    "mailparser": "^3.7.4",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "playwright": "^1.55.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "llm-scraper@^1.6.0": {
      "ai": "^5.0.44"
    }
  }
}
