{
  "name": "bento-mail",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "npm run dev & npm run mail & npm run worker & npm run rtdb",
    "dev": "NODE_OPTIONS=--enable-source-maps npm run build:services -- --watch --no-minify --sourcemap & next dev",
    "build": "NODE_OPTIONS='--max_old_space_size=6144' npm run build:services -- --minify && NODE_OPTIONS='--max_old_space_size=6144' next build",
    "build:services": "tsup src/services --format esm --out-dir dist/services --tsconfig tsconfig.services.json",
    "lint": "next lint",
    "unzip": "[ ! -d samples ] && unzip -q samples.zip || true",
    "postinstall": "npm run unzip",
    "test": "vitest --exclude tests/ai-article-analyzer",
    "mail": "npx nodemon --watch ./dist/services --watch scripts/start-mail-server.mjs --exec node scripts/start-mail-server.mjs",
    "worker": "npx nodemon --watch ./dist/services --watch ./scripts/start-worker.mjs --exec node scripts/start-worker.mjs",
    "rtdb": "npx nodemon --watch ./dist/services --watch ./scripts/start-rtdb.mjs --exec node scripts/start-rtdb.mjs",
    "agendash": "source .env && npx agendash --db=\"$MONGODB_URI\" --collection=agenda -p 3001"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.30",
    "@langchain/core": "^0.3.21",
    "@langchain/openai": "^0.6.13",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@typegoose/typegoose": "^12.19.0",
    "axios": "^1.7.0",
    "better-auth": "^1.4.5",
    "chronos-jobs": "^1.0.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.2",
    "jsdom": "^26.1.0",
    "lucide-react": "^0.544.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.1",
    "next": "^15.5.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tailwind-merge": "^3.3.1",
    "turndown": "^7.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@swc/core": "^1.13.19",
    "@types/jsdom": "^21.1.7",
    "@types/maildev": "^0.0.7",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^22.18.1",
    "@types/react": "^18.2.73",
    "@types/react-dom": "^18.2.21",
    "@types/turndown": "^5.0.5",
    "autoprefixer": "^10.4.20",
    "eslint": "9.36.0",
    "eslint-config-next": "15.5.4",
    "llm-scraper": "^1.6.0",
    "maildev": "^2.2.1",
    "mailparser": "^3.7.5",
    "mongodb-runner": "^6.2.0",
    "nodemailer": "^7.0.6",
    "nodemon": "^3.1.10",
    "playwright": "^1.55.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "tsup": "^8.5.0",
    "typescript": "5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "llm-scraper@^1.6.0": {
      "ai": "^5.0.44"
    }
  }
}
