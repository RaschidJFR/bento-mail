# Rename this file to .env and fill in the values before running the application.
# Commented variables are optional.

# OpenAI API key
OPENAI_API_KEY=your_openai_api_key_here

# Url where your app is running
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# MongoDB connection string and database name
MONGODB_URI=mongodb://localhost:27017/
DATABASE_NAME=development

# Google OAuth Credentials
# See https://www.better-auth.com/docs/authentication/google
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Better Auth encryption key.
# See https://www.better-auth.com/docs/reference/options#secret
BETTER_AUTH_SECRET=your_better_auth_secret

# Mail Server
SMTP_PORT=1025
SMTP_HOST=localhost
# ALLOWED_EMAIL_HOSTS=example.com

# Task Scheduler
# See [Human Interval](https://github.com/agenda/human-interval)
WORKER_PROCESSING_INTERVAL="30 seconds"

# [Optional] Mongoose Studio Pro API key for /studio auth.
# Without it, Mongoose Studio only accepts localhost connections.
# MONGOOSE_STUDIO_API_KEY=your_mongoose_studio_api_key
